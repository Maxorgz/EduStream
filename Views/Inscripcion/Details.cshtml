@model EduStream.Models.Inscripcion
@{
    ViewData["Title"] = "Detalle de Inscripción";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-receipt"></i> Comprobante de Inscripción #@Model.Id</h5>
                <span class="badge bg-light text-dark fs-6">@Model.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            
            <div class="card-body p-4 bg-light">
                <div class="row mb-4">
                    <div class="col-sm-6">
                        <h6 class="text-muted fw-bold mb-1">Datos del Estudiante</h6>
                        <p class="fs-5 mb-0">@(Model.Estudiante?.Nombre) @(Model.Estudiante?.Apellido)</p>
                        <p class="text-muted small">@Model.Estudiante?.Email</p>
                    </div>
                    <div class="col-sm-6 text-sm-end">
                        <h6 class="text-muted fw-bold mb-1">Curso Inscripto</h6>
                        <p class="fs-5 mb-0 fw-bold text-primary">@(Model.Curso?.Titulo)</p>
                        <p class="text-muted small">Categoria: @(Model.Curso?.Categoria?.Nombre ?? "N/A")</p>
                    </div>
                </div>

                <div class="bg-white p-3 rounded border shadow-sm mb-4">
                    <div class="row text-center">
                        <div class="col-4">
                            <span class="d-block text-muted small fw-bold">MONTO ABONADO</span>
                            <span class="fs-4 fw-bold text-success">$@Model.MontoPago.ToString("N2")</span>
                        </div>
                        <div class="col-4 border-start border-end">
                            <span class="d-block text-muted small fw-bold">ESTADO DEL PAGO</span>
                            <span class="badge @(Model.EstadoPago == "Aprobado" ? "bg-success" : (Model.EstadoPago == "Pendiente" ? "bg-warning text-dark" : "bg-danger")) fs-6 mt-1">
                                @Model.EstadoPago
                            </span>
                        </div>
                        <div class="col-4">
                            <span class="d-block text-muted small fw-bold">ESTADO GENERAL</span>
                            <span class="badge @(Model.Estado == "Activa" ? "bg-primary" : "bg-secondary") fs-6 mt-1">
                                @Model.Estado
                            </span>
                        </div>
                    </div>
                </div>

                <div class="text-center">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                            <i class="bi bi-arrow-left"></i> Volver a Gestion
                        </a>
                    }
                    else
                    {
                        <a asp-action="MisInscripciones" class="btn btn-outline-secondary fw-bold">
                            <i class="bi bi-arrow-left"></i> Volver a Mis Cursos
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>