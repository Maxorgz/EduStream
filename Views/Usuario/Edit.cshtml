@model EduStream.Models.Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-gear"></i> Editar Usuario</h4>
            </div>
            <div class="card-body p-4 bg-light">
                
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="PasswordHash" />
                    <input type="hidden" asp-for="FechaRegistro" />
                    <input type="hidden" asp-for="AvatarUrl" />
                    <input type="hidden" asp-for="Activo" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                            <input asp-for="Nombre" class="form-control" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Apellido" class="form-label fw-bold">Apellido</label>
                            <input asp-for="Apellido" class="form-control" required />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Dni" class="form-label fw-bold">DNI</label>
                            <input asp-for="Dni" class="form-control" />
                            <span asp-validation-for="Dni" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" class="form-control" type="email" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4 p-3 border border-warning rounded bg-white">
                        <label asp-for="Rol" class="form-label fw-bold text-danger"><i class="bi bi-shield-exclamation"></i> Rol del Sistema</label>
                        <select asp-for="Rol" class="form-select border-warning">
                            <option value="Estudiante">Estudiante</option>
                            <option value="Profesor">Profesor</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                        <div class="form-text mt-2 text-muted">
                            Asignar el rol de Administrador otorga acceso total a la plataforma.
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary fw-bold shadow-sm">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}