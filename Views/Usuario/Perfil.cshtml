@model EduStream.Models.Usuario
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4 border-0">
                
                <!-- Mostramos el Avatar o el Ícono por defecto -->
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle shadow-sm border border-3 border-white" style="width: 120px; height: 120px; object-fit: cover;" />
                }
                else
                {
                    <i class="bi bi-person-circle display-1 shadow-sm rounded-circle bg-white text-primary px-2"></i>
                }

                <h3 class="mt-3 mb-0 fw-bold">@Model.Nombre @Model.Apellido</h3>
                <p class="mb-0 text-white-50">@Model.Email</p>
            </div>
            
            <div class="card-body p-4 bg-light">
                
                <!-- Formulario para actualizar la foto -->
                <form asp-action="ActualizarAvatar" method="post" enctype="multipart/form-data" class="mb-4 bg-white p-3 rounded shadow-sm">
                    <input type="hidden" asp-for="Id" />
                    <label class="form-label fw-bold small text-muted">CAMBIAR FOTO DE PERFIL</label>
                    <div class="input-group">
                        <input asp-for="AvatarFile" type="file" class="form-control form-control-sm" accept="image/*" required />
                        <button type="submit" class="btn btn-primary btn-sm fw-bold">Subir</button>
                    </div>
                </form>

                <div class="row text-center mb-3">
                    <div class="col-6 border-end">
                        <span class="d-block text-muted small fw-bold mb-1">ROL</span>
                        <span class="badge @(Model.Rol == "Administrador" ? "bg-danger" : Model.Rol == "Profesor" ? "bg-success" : "bg-primary") fs-6 px-3 py-2 shadow-sm">
                            @Model.Rol
                        </span>
                    </div>
                    <div class="col-6">
                        <span class="d-block text-muted small fw-bold mb-1">MIEMBRO DESDE</span>
                        <span class="fs-6 fw-bold text-dark">
                            @Model.FechaRegistro.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                </div>
            </div>
            
            <div class="card-footer bg-white text-center py-3 border-top-0">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">
                    <i class="bi bi-arrow-left"></i> Volver al Inicio
                </a>
            </div>
        </div>
    </div>
</div>