@model IEnumerable<EduStream.Models.ProgresoLeccion>
@{
    ViewData["Title"] = "Aula Virtual";
    int inscripcionId = ViewBag.InscripcionId;
    int totalLecciones = Model?.Count() ?? 0;
    int completadas = ViewBag.TotalCompletadas ?? 0;
    
    // Porcentaje de progreso
    int porcentaje = totalLecciones > 0 ? (int)Math.Round((double)completadas / totalLecciones * 100) : 0;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold"><i class="bi bi-laptop text-primary"></i> Aula Virtual</h2>
        <a asp-controller="Inscripcion" asp-action="MisInscripciones" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Mis Cursos
        </a>
    </div>

    <!-- Barra de Progreso General -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-1">
                <span class="fw-bold">Tu progreso en el curso</span>
                <span class="fw-bold text-primary" id="textoPorcentaje">@porcentaje% (@completadas de @totalLecciones)</span>
            </div>
            <div class="progress" style="height: 20px;">
                <div id="barraPorcentaje" class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
                     role="progressbar" style="width: @porcentaje%;" 
                     aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    </div>

    <!-- Lista de Clases -->
    @if (Model != null && Model.Any())
    {
        <div class="accordion shadow-sm" id="accordionClases">
            @foreach (var progreso in Model.OrderBy(p => p.Leccion?.Orden))
            {
                var leccion = progreso.Leccion;
                if (leccion == null) continue;

                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading-@leccion.Id">
                        <button class="accordion-button @(progreso.Completada ? "bg-light" : "") collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@leccion.Id">
                            
                            <!-- Icono segun estado -->
                            <i id="icono-@leccion.Id" class="bi @(progreso.Completada ? "bi-check-circle-fill text-success" : "bi-circle text-muted") fs-5 me-3"></i>
                            
                            <span class="fw-bold">Clase @leccion.Orden: @leccion.Titulo</span>
                        </button>
                    </h2>
                    <div id="collapse-@leccion.Id" class="accordion-collapse collapse" data-bs-parent="#accordionClases">
                        <div class="accordion-body">
                            
                            <!-- Contenido Teórico -->
                            <div class="mb-4 text-break" style="white-space: pre-line;">
                                @(string.IsNullOrEmpty(leccion.Contenido) ? "Sin contenido teórico." : leccion.Contenido)
                            </div>

                            <!-- Materiales Adjuntos -->
                            @if (leccion.Materiales != null && leccion.Materiales.Any())
                            {
                                <h6 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-paperclip"></i> Recursos Descargables</h6>
                                <ul class="list-group mb-4">
                                    @foreach (var mat in leccion.Materiales)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="bi bi-file-earmark-text text-danger me-2"></i>
                                                <span class="fw-bold">@mat.Titulo</span>
                                                <span class="badge bg-secondary ms-2">@mat.TipoArchivo</span>
                                            </div>
                                            <a asp-controller="MaterialEstudio" asp-action="Descargar" asp-route-id="@mat.Id" class="btn btn-sm btn-info text-white">
                                                <i class="bi bi-download"></i> Descargar
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }

                            <!-- Completado (AJAX) -->
                            <div class="text-end border-top pt-3">
                                <div class="form-check form-switch d-inline-block text-start">
                                    <input class="form-check-input fs-5 check-progreso" type="checkbox" role="switch" 
                                           id="switch-@leccion.Id" 
                                           @(progreso.Completada ? "checked" : "")
                                           onchange="actualizarProgreso(@inscripcionId, @leccion.Id, this)">
                                    <label class="form-check-label ms-2 mt-1 fw-bold" for="switch-@leccion.Id" id="label-@leccion.Id">
                                        @(progreso.Completada ? "Clase Completada" : "Marcar como Completada")
                                    </label>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            Este curso no tiene lecciones publicadas.
        </div>
    }
</div>

@section Scripts {
    <script>
        async function actualizarProgreso(inscripcionId, leccionId, checkboxElement) {
            const completada = checkboxElement.checked;
            
            // Actualizamos la interfaz inmediatamente para que se sienta rápido
            const label = document.getElementById(`label-${leccionId}`);
            const icono = document.getElementById(`icono-${leccionId}`);
            
            if (completada) {
                label.innerText = "Clase Completada";
                icono.classList.replace('bi-circle', 'bi-check-circle-fill');
                icono.classList.replace('text-muted', 'text-success');
            } else {
                label.innerText = "Marcar como Completada";
                icono.classList.replace('bi-check-circle-fill', 'bi-circle');
                icono.classList.replace('text-success', 'text-muted');
            }

            // Llamada AJAX a tu controlador
            try {
                const response = await fetch('/ProgresoLeccion/ActualizarProgresoAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        InscripcionId: inscripcionId,
                        LeccionId: leccionId,
                        Completada: completada
                    })
                });

                const data = await response.json();
                if (!data.success) {
                    alert("Hubo un problema al guardar tu progreso.");
                    checkboxElement.checked = !completada; // Revertimos si falla
                } else {
                    // Actualizamos la barra de progreso
                    const porcentaje = data.porcentaje;
                    const completadas = data.completadas;
                    const totalLecciones = data.totalLecciones;

                    document.getElementById('barraPorcentaje').style.width = porcentaje + '%';
                    document.getElementById('barraPorcentaje').setAttribute('aria-valuenow', porcentaje);
                    document.getElementById('textoPorcentaje').innerText = `${porcentaje}% (${completadas} de ${totalLecciones})`;
                }
            } catch (error) {
                console.error('Error:', error);
                alert("Error de conexión.");
            }
        }
    </script>
}