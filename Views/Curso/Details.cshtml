@model EduStream.Models.Curso
@{
    ViewData["Title"] = "Detalles del Curso: " + Model.Titulo;
}

<!-- Portada y boton para regresar -->
<div class="row mb-4 mt-3 align-items-center">
    <div class="col-md-8">
        <h2 class="mb-0 text-success fw-bold">@Model.Titulo</h2>
        <p class="text-muted fs-5 mb-0">Categoría: @(Model.Categoria?.Nombre ?? "Sin categoría")</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Mis Cursos
        </a>
    </div>
</div>

<!-- Info del Curso -->
<div class="card shadow-sm mb-5 border-0">
    <div class="row g-0">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.PortadaUrl))
            {
                <img src="@Model.PortadaUrl" class="img-fluid rounded-start h-100 w-100" style="object-fit: cover; min-height: 200px;" alt="Portada del curso">
            }
            else
            {
                <div class="bg-dark text-white d-flex align-items-center justify-content-center h-100 rounded-start" style="min-height: 200px;">
                    <div class="text-center">
                        <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                        <p class="mb-0 mt-2">Sin portada</p>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="card-body d-flex flex-column h-100">
                <h5 class="card-title fw-bold border-bottom pb-2">Descripcion General</h5>
                <p class="card-text flex-grow-1">@Model.Descripcion</p>
                
                <div class="row text-center mt-3 pt-3 border-top bg-light rounded py-2 mx-1">
                    <div class="col-4">
                        <span class="text-muted d-block" style="font-size: 0.85rem;">PRECIO</span>
                        <strong class="fs-5">$@Model.Precio.ToString("N2")</strong>
                    </div>
                    <div class="col-4 border-start border-end">
                        <span class="text-muted d-block" style="font-size: 0.85rem;">CUPO</span>
                        <strong class="fs-5">@(Model.CupoMaximo.HasValue ? Model.CupoMaximo.Value.ToString() : "Ilimitado")</strong>
                    </div>
                    <div class="col-4">
                        <span class="text-muted d-block" style="font-size: 0.85rem;">ESTADO</span>
                        <span class="badge @(Model.Estado == "Activo" ? "bg-success" : "bg-warning") fs-6 mt-1">@Model.Estado</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sección del Plan de Estudios (Lecciones) -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold"><i class="bi bi-list-ol text-primary"></i> Plan de Estudios</h3>
    
    <!-- Este boton llama al Create de la LeccionController, pasandole el ID de este curso -->
    <a asp-controller="Leccion" asp-action="Create" asp-route-cursoId="@Model.Id" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle"></i> Agregar Lección
    </a>
</div>

@if (Model.Lecciones != null && Model.Lecciones.Any())
{
    <div class="accordion shadow-sm" id="accordionLecciones">
        @foreach (var leccion in Model.Lecciones.OrderBy(l => l.Orden))
        {
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@leccion.Id">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@leccion.Id" aria-expanded="false" aria-controls="collapse-@leccion.Id">
                        <span class="badge bg-primary me-3">Clase @leccion.Orden</span>
                        <span class="fw-bold">@leccion.Titulo</span>
                    </button>
                </h2>
                <div id="collapse-@leccion.Id" class="accordion-collapse collapse" aria-labelledby="heading-@leccion.Id" data-bs-parent="#accordionLecciones">
                    <div class="accordion-body bg-light">
                        <p>@(string.IsNullOrEmpty(leccion.Contenido) ? "Sin descripción detallada." : leccion.Contenido)</p>
                        
                        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
                            <!-- Botón para ir al LeccionController -> Details (donde se suben los Materiales PDF/Video) -->
                            <a asp-controller="Leccion" asp-action="Details" asp-route-id="@leccion.Id" class="btn btn-sm btn-info text-white">
                                <i class="bi bi-paperclip"></i> Materiales
                            </a>
                            <a asp-controller="Leccion" asp-action="Edit" asp-route-id="@leccion.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <form asp-controller="Leccion" asp-action="Delete" asp-route-id="@leccion.Id" method="post" class="d-inline" onsubmit="return confirm('¿Seguro de querer eliminar la leccion @leccion.Orden? Tambien se borraran sus materiales.');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-secondary text-center shadow-sm py-4">
        <i class="bi bi-journal-x fs-1 text-muted d-block mb-2"></i>
        Este curso no tiene clases asignadas.<br />
        Haz clic en <strong>"Agregar Lección"</strong> para empezar a construir los temas.
    </div>
}