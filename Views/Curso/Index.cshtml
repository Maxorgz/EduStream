@model IEnumerable<EduStream.Models.Curso>
@{
    ViewData["Title"] = "Mis Cursos";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2><i class="bi bi-easel"></i> Mis Cursos</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nuevo Curso
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Portada</th>
                        <th>Título</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(item.PortadaUrl))
                                    {
                                        <img src="@item.PortadaUrl" alt="Portada" class="img-thumbnail"
                                             style="width: 60px; height: 45px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Sin imagen</span>
                                    }
                                </td>
                                <td class="fw-bold">@item.Titulo</td>
                                <td>@(item.Categoria?.Nombre ?? "Sin asignar")</td>
                                <td>$@item.Precio.ToString("N2")</td>
                                <td>
                                    <span class="badge @(item.Estado == "Activo" ? "bg-success" : "bg-warning")">
                                        @item.Estado
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white"
                                       title="Ver Clases">
                                        <i class="bi bi-eye"></i> Clases
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <!-- Botón para Cambiar Estado (Activar / Dar de baja) -->
                                    <form asp-action="CambiarEstado" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @if (item.Estado == "Inactivo")
                                        {
                                            <!-- Botón Verde (Restaurar) -->
                                            <button type="submit" class="btn btn-sm btn-success" title="Restaurar Curso"
                                                    onclick="return confirm('¿Estás seguro de que deseas volver a publicar este curso?');">
                                                <i class="bi bi-arrow-counterclockwise"></i> Activar
                                            </button>
                                        }
                                        else
                                        {
                                            <!-- Botón Rojo para Eliminar/Baja -->
                                            <button type="submit" class="btn btn-sm btn-danger" title="Dar de baja"
                                                    onclick="return confirm('¿¿Seguro que quieres dar de baja este curso? Ningún estudiante podrá verlo ni acceder a sus clases.');">
                                                <i class="bi bi-trash"></i> Suspender
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No creaste ningun curso. ¡Empieza hoy!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación -->
@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Navegación de páginas" class="mt-4 pb-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pagina="@i" 
                       asp-route-buscar="@ViewBag.BusquedaActual">@i</a>
                </li>
            }
        </ul>
    </nav>
}