@model IEnumerable<EduStream.Models.Curso>
@{
    ViewData["Title"] = "Catálogo de Cursos";
}

<div class="text-center my-5">
    <h1 class="display-5 fw-bold text-primary">Catalogo de Cursos</h1>
    <p class="lead text-muted">Aprende a tu propio ritmo con nuestros expertos.</p>
</div>

<!-- Buscador-->
<div class="row justify-content-center mb-5">
    <div class="col-md-6">
        <form asp-action="Catalogo" method="get" class="d-flex shadow-sm">
            <input class="form-control form-control-lg border-primary border-end-0 rounded-start" type="search" name="buscar" placeholder="¿Qué quieres aprender hoy?" aria-label="Buscar">
            <button class="btn btn-primary btn-lg rounded-end" type="submit">
                <i class="bi bi-search"></i> Buscar
            </button>
        </form>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
    @if (Model != null && Model.Any())
    {
        @foreach (var curso in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 class-hover-zoom">
                    <!-- Portada -->
                    @if (!string.IsNullOrEmpty(curso.PortadaUrl))
                    {
                        <img src="@curso.PortadaUrl" class="card-img-top" alt="@curso.Titulo" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center card-img-top" style="height: 200px;">
                            <i class="bi bi-image fs-1"></i>
                        </div>
                    }

                    <!-- Cuerpo de la Tarjeta -->
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-info text-dark">@(curso.Categoria?.Nombre ?? "General")</span>
                        </div>
                        <h5 class="card-title fw-bold">@curso.Titulo</h5>
                        
                        <!-- Descripcion -->
                        <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                            @(curso.Descripcion.Length > 100 ? curso.Descripcion.Substring(0, 100) + "..." : curso.Descripcion)
                        </p>
                        
                        <div class="mt-3">
                            <span class="fs-4 fw-bold text-success">$@curso.Precio.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- boton -->
                    <div class="card-footer bg-white border-top-0 pb-3 text-center">
                        <a asp-action="Details" asp-route-id="@curso.Id" class="btn btn-outline-primary w-100 fw-bold">
                            Ver Detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-emoji-frown fs-1 text-muted d-block mb-3"></i>
            <h4 class="text-muted">No encontramos cursos disponibles por el momento.</h4>
        </div>
    }
</div>

<!-- Estilo momentaneo  -->
<style>
    .class-hover-zoom {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .class-hover-zoom:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
    }
</style>