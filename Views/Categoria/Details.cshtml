@model EduStream.Models.Categoria
@{
    ViewData["Title"] = "Detalle de Categoría";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="text-primary fw-bold"><i class="bi bi-tag"></i> @Model.Nombre</h2>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver a Categorias
            </a>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4 bg-light">
                <h5 class="fw-bold border-bottom pb-2">Descripcion</h5>
                <p class="fs-5 text-muted mb-0">
                    @(string.IsNullOrEmpty(Model.Descripcion) ? "Esta categoria no tiene una descripcion detallada." : Model.Descripcion)
                </p>
            </div>
        </div>

        <h4 class="fw-bold mb-3"><i class="bi bi-easel"></i> Cursos en esta Categoria</h4>
        
        @if (Model.Cursos != null && Model.Cursos.Any())
        {
            <div class="list-group shadow-sm">
                @foreach (var curso in Model.Cursos)
                {
                    <a asp-controller="Curso" asp-action="Details" asp-route-id="@curso.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                        <div>
                            <h6 class="mb-0 fw-bold">@curso.Titulo</h6>
                            <small class="text-muted">Estado: @curso.Estado</small>
                        </div>
                        <span class="badge bg-success rounded-pill fs-6">$@curso.Precio.ToString("N2")</span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary text-center shadow-sm">
                <i class="bi bi-journal-x fs-2 text-muted d-block mb-2"></i>
                Todavia no hay cursos asociados a esta categoria.
            </div>
        }

    </div>
</div>