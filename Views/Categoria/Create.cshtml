@model EduStream.Models.Categoria
@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-tag-fill"></i> Crear Categoria</h5>
            </div>
            <div class="card-body p-4 bg-light">
                
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                        <input asp-for="Nombre" class="form-control shadow-sm" placeholder="Ej: Desarrollo Web" required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-bold">Descripcion (Opcional)</label>
                        <textarea asp-for="Descripcion" class="form-control shadow-sm" rows="4" placeholder="Breve detalle sobre esta categoria..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success fw-bold shadow-sm">
                            <i class="bi bi-save"></i> Guardar
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}